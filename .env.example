# Provider configuration. The default is OpenAI.
OPENAI_API_KEY=sk-your-key-here
# OpenAI models start at GPT-5. Any model not in the allow-list is rejected.
# See every accepted ID with: python agent.py --list-models
OPENAI_MODEL=gpt-5-mini

# Optional: use DeepSeek instead.
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-key
# Supported DeepSeek models: deepseek-flash, deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-flash

# Web research (optional; the agent continues without it if missing).
TAVILY_API_KEY=tvly-your-key-here

# Optional: default issue domain (software, ai, finance, cybersecurity).
# ISSUE_DOMAIN=software

# Optional: directory the web viewer scans for plan JSON files.
# Defaults to outputs, the directory agent.py writes to.
# PLANS_DIR=outputs
